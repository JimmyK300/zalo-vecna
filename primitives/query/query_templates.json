  "examples": [
    {
      "id": "top_products",
      "question_template": "Tháng {month}/{year}, {n} món nào bán chạy nhất?",
      "entity": "product",
      "metric": "quantity_sold",
      "time": [
        {
          "mode": "period",
          "field": "order_date",
          "period": "month_M_Y",
          "month": "{month}",
          "year": "{year}"
        }
      ],
      "group_by": [
        "product_id"
      ],
      "operations": [
        {
          "id": "volume",
          "op": "sum",
          "input": "facts",
          "value": "quantity_sold"
        },
        {
          "id": "leaders",
          "op": "top_n",
          "input": "volume",
          "by": "volume",
          "direction": "desc",
          "n": "{n}"
        }
      ],
      "output": {
        "type": "list",
        "fields": [
          "product_name"
        ]
      },
      "rule_refs": [
        "best_selling_items",
        "result_order"
      ]
    },
    {
      "id": "repeat_buyer_share",
      "question_template": "Trong tháng {month}/{year}, khách mua từ {min_orders} đơn trở lên chiếm bao nhiêu phần trăm số khách đã mua?",
      "entity": "customer",
      "metric": "order_count",
      "time": [
        {
          "mode": "period",
          "field": "order_date",
          "period": "month_M_Y",
          "month": "{month}",
          "year": "{year}"
        }
      ],
      "filters": [
        {
          "field": "customer_id",
          "operator": "is_known"
        }
      ],
      "group_by": [
        "customer_id"
      ],
      "baseline": {
        "description": "Tất cả khách đã mua trong cùng kỳ, không áp ngưỡng số đơn."
      },
      "operations": [
        {
          "id": "orders_per_customer",
          "op": "count_distinct",
          "input": "facts",
          "value": "order_id",
          "group_by": [
            "customer_id"
          ]
        },
        {
          "id": "repeat_buyers",
          "op": "filter",
          "input": "orders_per_customer",
          "condition": {
            "field": "orders_per_customer",
            "operator": ">=",
            "value": "{min_orders}"
          }
        },
        {
          "id": "numerator",
          "op": "count_distinct",
          "input": "repeat_buyers",
          "value": "customer_id",
          "group_by": []
        },
        {
          "id": "denominator",
          "op": "count_distinct",
          "input": "orders_per_customer",
          "value": "customer_id",
          "group_by": []
        },
        {
          "id": "share",
          "op": "share_percent",
          "numerator": "numerator",
          "denominator": "denominator"
        }
      ],
      "output": {
        "type": "percent",
        "fields": [
          "share"
        ]
      },
      "rule_refs": [
        "valid_revenue_orders",
        "customer_identity"
      ]
    },
    {
      "id": "month_to_date_growth",
      "question_template": "Doanh thu từ đầu tháng tới hôm nay tăng hay giảm bao nhiêu phần trăm so với cùng kỳ tháng trước?",
      "entity": "shop",
      "metric": "revenue",
      "time": [
        {
          "mode": "relative_period",
          "field": "order_date",
          "period": "this_month",
          "anchor": "{as_of_date}"
        }
      ],
      "baseline": {
        "time": [
          {
            "mode": "relative_period",
            "field": "order_date",
            "period": "last_month_same_days",
            "anchor": "{as_of_date}"
          }
        ]
      },
      "operations": [
        {
          "id": "current_revenue",
          "op": "sum",
          "input": "facts",
          "value": "revenue"
        },
        {
          "id": "prior_revenue",
          "op": "sum",
          "input": "baseline",
          "value": "revenue"
        },
        {
          "id": "growth",
          "op": "change_percent",
          "current": "current_revenue",
          "prior": "prior_revenue"
        }
      ],
      "output": {
        "type": "percent",
        "fields": [
          "growth"
        ]
      },
      "rule_refs": [
        "this_month",
        "last_month_same_days",
        "pct_growth",
        "data_coverage"
      ]
    },
    {
      "id": "delivery_count_by_order_period",
      "question_template": "Các đơn đặt tháng {month}/{year} đã được giao bao nhiêu đợt tính tới hôm nay?",
      "entity": "delivery",
      "metric": "delivery_count",
      "time": [
        {
          "mode": "period",
          "field": "order_date",
          "period": "month_M_Y",
          "month": "{month}",
          "year": "{year}"
        },
        {
          "mode": "as_of",
          "field": "delivery_date",
          "end_date": "{as_of_date}",
          "period": "until_date_X"
        }
      ],
      "operations": [
        {
          "id": "deliveries",
          "op": "count_distinct",
          "input": "facts",
          "value": [
            "order_id",
            "delivery_number"
          ]
        }
      ],
      "output": {
        "type": "number",
        "fields": [
          "deliveries"
        ]
      },
      "rule_refs": [
        "building_materials (dev_004)",
        "data_coverage"
      ],
      "industry_primitive_group": "building_materials (dev_004)"
    },
    {
      "id": "top_customer_debt_table",
      "question_template": "Tính đến hết {date}, {n} khách nào còn nợ nhiều nhất và mỗi người còn nợ bao nhiêu?",
      "entity": "customer",
      "metric": "debt_balance",
      "time": [
        {
          "mode": "as_of",
          "field": "debt_events",
          "end_date": "{date}",
          "period": "until_date_X"
        }
      ],
      "filters": [
        {
          "field": "customer_id",
          "operator": "is_known"
        }
      ],
      "group_by": [
        "customer_id"
      ],
      "operations": [
        {
          "id": "balance",
          "op": "sum",
          "input": "facts",
          "value": "debt_balance"
        },
        {
          "id": "leaders",
          "op": "top_n",
          "input": "balance",
          "by": "balance",
          "direction": "desc",
          "n": "{n}"
        }
      ],
      "output": {
        "type": "table",
        "fields": [
          "customer_name",
          "balance"
        ],
        "columns": [
          "khach_hang",
          "so_tien_no"
        ]
      },
      "rule_refs": [
        "order_owed_at_date_X",
        "total_debt_at_date_X",
        "customer_debt_table",
        "customer_identity",
        "result_order"
      ]
    },
    {
      "id": "earliest_expiry_date",
      "question_template": "Lô {product_name} gần hết hạn nhất có hạn dùng ngày nào?",
      "entity": "batch",
      "time": [
        {
          "mode": "as_of",
          "field": "inventory_events",
          "end_date": "{as_of_date}",
          "period": "until_date_X"
        }
      ],
      "filters": [
        {
          "field": "product_id",
          "operator": "=",
          "value": "{product_id}"
        },
        {
          "field": "inventory_quantity",
          "operator": ">",
          "value": 0
        },
        {
          "field": "expiry_date",
          "operator": ">=",
          "value": "{as_of_date}"
        }
      ],
      "operations": [
        {
          "id": "batch",
          "op": "top_n",
          "input": "facts",
          "by": "expiry_date",
          "direction": "asc",
          "n": 1
        },
        {
          "id": "expiry_date",
          "op": "select",
          "input": "batch",
          "fields": [
            "expiry_date"
          ]
        }
      ],
      "output": {
        "type": "date",
        "fields": [
          "expiry_date"
        ]
      },
      "rule_refs": [
        "pharmacy (dev_005, dev_006)",
        "data_coverage"
      ],
      "industry_primitive_group": "pharmacy (dev_005, dev_006)",
      "requires_capabilities": [
        "has_lot_expiry"
      ]
    },
    {
      "id": "sold_quantity_by_base_unit",
      "question_template": "Tháng {month}/{year}, shop bán được bao nhiêu {unit}?",
      "entity": "product",
      "metric": "quantity_sold",
      "time": [
        {
          "mode": "period",
          "field": "order_date",
          "period": "month_M_Y",
          "month": "{month}",
          "year": "{year}"
        }
      ],
      "filters": [
        {
          "field": "base_unit",
          "operator": "=",
          "value": "{unit}"
        }
      ],
      "operations": [
        {
          "id": "volume",
          "op": "sum",
          "input": "facts",
          "value": "quantity_sold"
        }
      ],
      "output": {
        "type": "number",
        "fields": [
          "volume"
        ]
      },
      "rule_refs": [
        "unit_filtered_quantity",
        "unit_conversion"
      ]
    }
  ]
}
