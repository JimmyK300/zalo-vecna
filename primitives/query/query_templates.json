        "customer_identity",
        "distinct_buying_customers"
      ]
    },
    "purchase_day_count": {
      "grain": "order",
      "time_field": "order_date",
      "distinct_key": "order_date",
      "default_operation": "count_distinct",
      "rule_refs": [
        "valid_revenue_orders",
        "customer_identity"
      ]
    },
    "average_order_value": {
      "grain": "order",
      "time_field": "order_date",
      "unit": "VND",
      "default_operation": "mean",
      "rule_refs": [
        "valid_revenue_orders",
        "order_revenue",
        "avg_order_value"
      ]
    },
    "debt_balance": {
