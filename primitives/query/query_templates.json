  "metrics": {
    "revenue": {
      "grain": "order_or_sale_line",
      "time_field": "order_date",
      "unit": "VND",
      "default_operation": "sum",
      "rule_refs": [
        "valid_revenue_orders",
        "order_revenue"
      ],
      "grain_note": "Tổng theo đơn dùng revenue_lines nếu schema shop có và hỗ trợ. Theo mặt hàng phải dùng cấp dòng đúng bảng của shop."
    },
    "gross_profit": {
      "grain": "sale_line",
      "time_field": "order_date",
      "unit": "VND",
      "default_operation": "sum",
      "rule_refs": [
        "valid_revenue_orders",
        "gross_profit"
      ],
      "requires_capabilities": [
        "has_cost_or_margin",
        "has_item_lines"
      ]
    },
    "net_profit": {
      "grain": "month",
      "time_field": "month",
      "unit": "VND",
      "rule_refs": [
        "valid_revenue_orders",
        "gross_profit",
        "net_profit_month"
      ],
      "requires_capabilities": [
        "has_cost_or_margin",
        "has_item_lines",
        "has_expense_book"
      ]
    },
    "quantity_sold": {
      "grain": "sale_line",
      "time_field": "order_date",
      "unit": "base_unit",
      "default_operation": "sum",
      "rule_refs": [
        "valid_revenue_orders",
        "unit_conversion"
      ],
      "requires_capabilities": [
        "has_item_lines"
      ]
    },
    "order_count": {
      "grain": "order",
      "time_field": "order_date",
      "distinct_key": "order_id",
